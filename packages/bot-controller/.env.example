# Token du bot Discord classique
BOT_TOKEN=

# Client ID du bot (pour deploy.js)
CLIENT_ID=

# Ton ID Discord (pour restreindre l'accès au panel)
OWNER_ID=

# Secret partagé avec sb-uhq (doit être identique des deux côtés, génère un secret avec un simple gestionnaire de mot de passe)
BRIDGE_SECRET=

# URL du serveur bridge du selfbot
BRIDGE_URL=http://127.0.0.1:3000

# Port et URL pour les logs en MP
LOG_PORT=3001
BRIDGE_CONTROLLER_URL=http://127.0.0.1:3001
